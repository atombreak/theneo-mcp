# Theneo API Configuration
# Get your API key from https://app.theneo.io/

# Required: Your Theneo API key
THENEO_API_KEY=your_theneo_api_key_here

# Optional: Override default URLs (usually not needed)
THENEO_BASE_API_URL=https://api.theneo.io
THENEO_BASE_APP_URL=https://app.theneo.io

# Optional: Specify which profile to use
THENEO_PROFILE=default

# Optional: Enable debug logging
# DEBUG=1

